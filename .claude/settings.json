{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-workout-context.sh",
            "timeout": 30,
            "statusMessage": "Checking the Telegram workout context"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "WORKOUT_CONTEXT.md",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-workout-context.sh",
            "timeout": 30,
            "statusMessage": "Syncing workout context to Telegram"
          }
        ]
      }
    ]
  }
}
